{
  "name": "ponto-certo",
  "version": "1.0.0",
  "description": "Dashboard de Monitoramento Climático e Logístico em Nuvem para Exportadoras de Frutas (Petrolina/Juazeiro) — ESP32 -> ThingSpeak -> API Node.js -> MongoDB Atlas",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test tests/unit/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/unit/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "zod": "^4.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
