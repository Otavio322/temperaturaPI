# --- Banco de dados MySQL (schema em src/db/schema.sql) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=climora
DB_PASSWORD=
DB_NAME=climora
# Provedores de MySQL na nuvem (PlanetScale, Aiven, RDS, Railway...) costumam exigir TLS.
DB_SSL=false
DB_POOL_SIZE=10

# --- Segurança ---
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=2h

# Origem(ns) do painel web (frontend separado). Obrigatório em produção.
CORS_ORIGINS=

# Se ligado, qualquer pessoa pode se cadastrar como PRODUTOR em /api/autenticacao/registrar
ALLOW_PUBLIC_REGISTER=true

# --- Servidor ---
NODE_ENV=development
PORT=3000
SLOW_REQUEST_MS=3000

# --- Integração com o ThingSpeak ---
# A tabela `sensor` só guarda o Channel ID (sem Read API Key) — assume canal público.
THINGSPEAK_POLL_INTERVAL_MS=20000
THINGSPEAK_BASE_URL=https://api.thingspeak.com
# Sensor sem thingspeak_channel_id (ou com canal inválido/vazio) gera leituras sintéticas
THINGSPEAK_SIMULATE_SEM_CANAL=true

# A partir de quanto tempo sem leitura um sensor ATIVO gera um alerta SENSOR_OFFLINE
SENSOR_OFFLINE_APOS_MIN=30

# Desliga os agendadores em segundo plano (útil em testes automatizados)
ENABLE_SCHEDULERS=true

# --- Administrador (usado por: npm run seed) ---
# Se o e-mail já existir (ex.: o admin de exemplo do schema.sql), o seed só redefine a senha dele.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=TroqueEssaSenha123
